    {
      "name": "13 Upload valid PNG",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.test('Metadata only (no path)', () => { const a = pm.response.json().attachment; pm.expect(a.id).to.be.a('string'); pm.expect(a).to.not.have.property('path'); pm.expect(a).to.not.have.property('storedName'); pm.collectionVariables.set('attachmentId', a.id); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/attachments",
          "host": [
            "{{baseUrl}}"
