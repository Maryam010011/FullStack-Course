{
  "info": {
    "name": "Campus Lost & Found API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "attachmentId",
      "value": ""
    },
    {
      "key": "itemId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 GET health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('status is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "02 POST valid lost item",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.test('Item has a generated id', () => { const b = pm.response.json(); pm.expect(b.item.id).to.be.a('string'); pm.collectionVariables.set('itemId', b.item.id); });",
              "pm.test('createdAt is present', () => pm.expect(pm.response.json().item.createdAt).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "items"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Black wallet\",\n  \"category\": \"Accessories\",\n  \"location\": \"Main Library\",\n  \"status\": \"lost\",\n  \"contactName\": \"Ayesha\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "03 POST valid found item",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "items"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Blue umbrella\",\n  \"category\": \"Accessories\",\n  \"location\": \"Main Library\",\n  \"status\": \"found\",\n  \"contactName\": \"Ayesha\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "04 GET filtered (status=lost)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Every item is lost', () => { const items = pm.response.json().items; pm.expect(items).to.be.an('array'); items.forEach(i => pm.expect(i.status).to.eql('lost')); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/items?status=lost",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "items"
          ],
          "query": [
            {
              "key": "status",
              "value": "lost"
            }
          ]
        }
      }
    },
